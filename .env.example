# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave publica do cliente. Projetos novos mostram "Publishable key" (sb_publishable_...),
# projetos antigos mostram "anon public" (eyJhbGciOi...). Preencha a que aparecer no painel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
